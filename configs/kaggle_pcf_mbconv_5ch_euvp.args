# Kaggle run config: PCF-MBConv U-Net (Dual-Branch + CSAGF + Rep-MBConv + HSV-CS Loss)
# Proposed Best Configuration on EUVP 5-channel setup.
# Usage:
# python train.py @configs/kaggle_pcf_mbconv_5ch_euvp.args --data_train_euvp /kaggle/input/euvp-dataset/EUVP

--model pcf_mbconv_5ch
--dataset euvp
--euvp_subset all
--pretrained_backbone False

# Training settings (Fast screen: 50 epochs, 1 seed)
--batchSize 16
--cropSize 256
--nEpochs 50
--lr 1e-4
--weight_decay 1e-5
--snapshots 5
--early_stop_patience 15

# Learning rate scheduler
--cos_restart False
--cos_restart_cyclic False
--scheduler_step 20
--scheduler_gamma 0.5
--start_warmup False
--warmup_epochs 0

# Multi-objective Loss settings: 1*L1 + 1*LPIPS + 0.5*HSV-CS
--L1_weight 1.0
--perceptual_weight 1.0
--SSIM_weight 0.0
--hsvcs_weight 0.5

# Kaggle-friendly runtime/output settings
--gpu_mode True
--num_gpus 1
--threads 2
--in_memory False
--checkpoint_dir /kaggle/working/checkpoints
--val_folder /kaggle/working/results
--run_name pcf_mbconv_5ch_euvp
