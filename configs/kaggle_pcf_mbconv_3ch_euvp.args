# Kaggle run config: PCF-MBConv U-Net (3-channel RGB-only variant)
# Isolates the contribution of UDCP physical priors vs RGB+HSV-CS dual-branch alone.
# Fast screening setup: 50 epochs, 1 seed.

--model pcf_mbconv_3ch
--dataset euvp
--euvp_subset all
--pretrained_backbone False

# Training settings (Fast screen: 50 epochs)
--batchSize 16
--cropSize 256
--nEpochs 50
--lr 1e-4
--weight_decay 1e-5
--snapshots 5
--early_stop_patience 15

# Learning rate scheduler
--cos_restart False
--cos_restart_cyclic False
--scheduler_step 20
--scheduler_gamma 0.5
--start_warmup False
--warmup_epochs 0

# Multi-objective Loss settings: 1*L1 + 1*LPIPS + 0.5*HSV-CS
--L1_weight 1.0
--perceptual_weight 1.0
--SSIM_weight 0.0
--hsvcs_weight 0.5

# Kaggle-friendly runtime/output settings
--gpu_mode True
--num_gpus 1
--threads 2
--in_memory False
--checkpoint_dir /kaggle/working/checkpoints
--val_folder /kaggle/working/results
--run_name pcf_mbconv_3ch_fast50
