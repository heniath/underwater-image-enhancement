# Kaggle run config: MBConv 5-channel baseline on EUVP
# Fast screening setup: 50 epochs, 1 seed.
# Usage:
# python train.py @configs/kaggle_mbconv_5ch_euvp.args --data_train_euvp /kaggle/input/euvp-dataset/EUVP

--model mbconv_5ch
--dataset euvp
--euvp_subset underwater_scenes
--pretrained_backbone False

# Training settings (Fast screen: 50 epochs, 1 seed, batch 8x2=16 for VRAM safety)
--batchSize 8
--grad_accumulation_steps 2
--cropSize 256
--nEpochs 50
--lr 1e-4
--weight_decay 1e-5
--snapshots 5
--early_stop_patience 15

# Learning rate scheduler
--cos_restart False
--cos_restart_cyclic False
--scheduler_step 20
--scheduler_gamma 0.5
--start_warmup False
--warmup_epochs 0

# Loss settings: 1*L1 + 1*LPIPS
--L1_weight 1.0
--perceptual_weight 1.0
--SSIM_weight 0.0
--hsvcs_weight 0.0

# Kaggle-friendly runtime/output settings
--gpu_mode True
--num_gpus 1
--threads 2
--in_memory False
--checkpoint_dir /kaggle/working/checkpoints
--val_folder /kaggle/working/results
--run_name mbconv_5ch_baseline
