# Kaggle run config: MBConv U-Net, original EUVP 5-channel setup.
# Usage:
# python train.py @configs/kaggle_mbconv_5ch_euvp.args --data_train_euvp /kaggle/input/<dataset-slug>/EUVP

--model mbconv_5ch
--dataset euvp
--euvp_subset underwater_dark
--pretrained_backbone False

# Original training defaults, written here so the branch is reproducible.
--batchSize 16
--cropSize 256
--nEpochs 200
--lr 1e-4
--weight_decay 1e-5
--snapshots 10
--early_stop_patience 20

# Original scheduler defaults.
--cos_restart False
--cos_restart_cyclic False
--scheduler_step 30
--scheduler_gamma 0.5
--start_warmup False
--warmup_epochs 0

# Original loss defaults.
--L1_weight 1.0
--perceptual_weight 1.0
--SSIM_weight 0.0

# Kaggle-friendly runtime/output settings.
--gpu_mode True
--num_gpus 1
--threads 2
--in_memory False
--checkpoint_dir /kaggle/working/checkpoints
--val_folder /kaggle/working/results
--run_name mbconv_5ch_euvp
